<UserControl
    x:Class="Legend2Tool.WPF.Views.DynamicMonsterSpawningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:Legend2Tool.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Legend2Tool.WPF.ViewModels"
    MinWidth="1000"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=vm:DynamicMonsterSpawningViewModel}"
    d:DesignHeight="540"
    d:DesignWidth="1070"
    mc:Ignorable="d">

    <UserControl.Resources>

        <cv:MonsterCountToRedBrushConverter x:Key="MonsterCountToRedBrushConverter" />

        <!--  =================================================  -->
        <!--  通用样式  -->
        <!--  =================================================  -->

        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type hc:NumericUpDown}}" TargetType="hc:NumericUpDown">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type CheckBox}}" TargetType="CheckBox">
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!--  页面大区域  -->
        <Style
            x:Key="SectionStyle"
            BasedOn="{StaticResource GroupBoxTab}"
            TargetType="GroupBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5" />
        </Style>

        <!--  配置项标题  -->
        <Style
            x:Key="SettingLabelStyle"
            BasedOn="{StaticResource {x:Type TextBlock}}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="4,2,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  过滤区域  -->
        <Style
            x:Key="FilterTextBoxStyle"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

    </UserControl.Resources>

    <!--  =========================================================  -->
    <!--  整体布局  -->
    <!--  =========================================================  -->

    <Grid Margin="6">

        <Grid.RowDefinitions>

            <!--  使用说明  -->
            <RowDefinition Height="Auto" />

            <!--  过滤条件  -->
            <RowDefinition Height="2*" />

            <!--  配置 + 生成结果  -->
            <RowDefinition Height="3*" />

        </Grid.RowDefinitions>

        <!--  =====================================================  -->
        <!--  使用说明  -->
        <!--  =====================================================  -->

        <Border
            Grid.Row="0"
            Margin="3,0,3,3"
            Padding="8,5"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">

            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="过滤规则：" />
                <Run Text="每行填写一个与 Mongen.txt 完全匹配的值。命中的数据将被忽略，不生成动态刷怪脚本；请勿添加多余符号。" />
            </TextBlock>

        </Border>

        <!--  =====================================================  -->
        <!--  ① 过滤条件  -->
        <!--  =====================================================  -->

        <GroupBox
            Grid.Row="1"
            Header="过滤条件"
            Style="{StaticResource SectionStyle}">

            <UniformGrid Columns="5">

                <!--  地图代码  -->
                <Grid Margin="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="2,0,2,3"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="地图代码" />

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource FilterTextBoxStyle}"
                        Text="{Binding FilterMapCode, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <!--  怪物名字  -->
                <Grid Margin="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="2,0,2,3"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="怪物名字" />

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource FilterTextBoxStyle}"
                        Text="{Binding FilterMonName, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <!--  怪物数量  -->
                <Grid Margin="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="2,0,2,3"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="怪物数量" />

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource FilterTextBoxStyle}"
                        Text="{Binding FilterMonCount, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <!--  刷新间隔  -->
                <Grid Margin="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="2,0,2,3"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="刷新间隔" />

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource FilterTextBoxStyle}"
                        Text="{Binding FilterInterval, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

                <!--  名字颜色  -->
                <Grid Margin="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="2,0,2,3"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="名字颜色" />

                    <TextBox
                        Grid.Row="1"
                        Style="{StaticResource FilterTextBoxStyle}"
                        Text="{Binding FilterMonNameColor, UpdateSourceTrigger=PropertyChanged}" />

                </Grid>

            </UniformGrid>

        </GroupBox>

        <!--  =====================================================  -->
        <!--  下半部分  -->
        <!--  =====================================================  -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <!--  动态刷怪规则  -->
                <ColumnDefinition Width="2*" />

                <!--  脚本与结果  -->
                <ColumnDefinition Width="3*" />

            </Grid.ColumnDefinitions>

            <!--  =================================================  -->
            <!--  ② 动态刷怪规则  -->
            <!--  =================================================  -->

            <GroupBox
                Grid.Column="0"
                Header="动态刷怪规则"
                Style="{StaticResource SectionStyle}">

                <Grid Grid.IsSharedSizeScope="True">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        将 10 个设置项拆成左右两组，
                        避免形成十行的超长竖向布局。
                    -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  =====================================  -->
                        <!--  左侧规则  -->
                        <!--  =====================================  -->

                        <Grid Grid.Column="0" Margin="0,0,6,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="RuleLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  时间单位  -->

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="时间单位" />

                            <ComboBox
                                Grid.Row="0"
                                Grid.Column="1"
                                SelectedValue="{Binding SelectedTimeUnit, Mode=TwoWay}"
                                SelectedValuePath="Content">

                                <ComboBoxItem Content="分" />
                                <ComboBoxItem Content="秒" />

                            </ComboBox>

                            <!--  刷怪间隔  -->

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="刷怪间隔" />

                            <hc:NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                Maximum="60"
                                Minimum="0"
                                Value="{Binding RefreshMonInterval}" />

                            <!--  清理怪物  -->

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="清理怪物" />

                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding IsClearMon}" />

                            <!--  清怪间隔  -->

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="清怪间隔" />

                            <hc:NumericUpDown
                                Grid.Row="3"
                                Grid.Column="1"
                                Maximum="60"
                                Minimum="0"
                                Value="{Binding ClearMonInterval}" />

                            <!--  刷怪倍数  -->

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="刷怪倍数" />

                            <hc:NumericUpDown
                                Grid.Row="4"
                                Grid.Column="1"
                                Maximum="10"
                                Minimum="1"
                                Value="{Binding RefreshMonMultiplier}" />

                        </Grid>

                        <!--  =====================================  -->
                        <!--  右侧限制  -->
                        <!--  =====================================  -->

                        <Grid Grid.Column="1" Margin="6,0,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="RuleLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  限制刷新时间  -->

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="限制刷新时长" />

                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding IsLimitRefreshInterval}" />

                            <!--  最大刷新时长  -->

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="最大刷新时长" />

                            <hc:NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                Maximum="600"
                                Minimum="0"
                                Value="{Binding MaxRefreshInterval}" />

                            <!--  单个怪物最大数量  -->

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="单怪数量上限" />

                            <hc:NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                Maximum="500"
                                Minimum="0"
                                Value="{Binding MaxRefreshCount}" />

                            <!--  单个地图最大数量  -->

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="地图数量上限" />

                            <hc:NumericUpDown
                                Grid.Row="3"
                                Grid.Column="1"
                                Maximum="10000"
                                Minimum="0"
                                Value="{Binding MaxMonstersPerMap}" />

                            <!--  注释 Mongen  -->

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Style="{StaticResource SettingLabelStyle}"
                                Text="注释Mongen" />

                            <CheckBox
                                Grid.Row="4"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                IsChecked="{Binding IsCommentMongen}" />

                        </Grid>

                    </Grid>

                    <!--  保存配置  -->

                    <Border
                        Grid.Row="1"
                        Margin="0,5,0,0"
                        Padding="0,5,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">

                        <Button
                            MinWidth="110"
                            HorizontalAlignment="Right"
                            Command="{Binding SaveConfigCommand}"
                            Content="保存规则配置"
                            Style="{StaticResource ButtonPrimary}" />

                    </Border>

                </Grid>

            </GroupBox>

            <!--  =================================================  -->
            <!--  右侧：脚本 + 结果  -->
            <!--  =================================================  -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>

                    <!--  脚本设置只占实际需要空间  -->
                    <RowDefinition Height="Auto" />

                    <!--  结果列表获得所有剩余空间  -->
                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <!--  =============================================  -->
                <!--  ③ 脚本生成  -->
                <!--  =============================================  -->

                <GroupBox
                    Grid.Row="0"
                    Header="脚本生成"
                    Style="{StaticResource SectionStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  刷怪触发字段  -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="4,2,6,2"
                            Text="刷怪触发字段" />

                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="100"
                            Text="{Binding RefreshMonTrigger}" />

                        <!--  清怪触发字段  -->

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="12,2,6,2"
                            Text="清怪触发字段" />

                        <TextBox
                            Grid.Row="0"
                            Grid.Column="3"
                            MinWidth="100"
                            Text="{Binding ClearMonTrigger}" />

                        <!--  操作按钮  -->

                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">

                            <Button
                                MinWidth="130"
                                Command="{Binding GenerateRefreshMonScriptCommand}"
                                Content="生成动态刷怪脚本"
                                Style="{StaticResource ButtonPrimary}" />

                            <Button
                                MinWidth="130"
                                Command="{Binding ClearRefreshMonScriptCommand}"
                                Content="清除动态刷怪脚本" />

                        </StackPanel>

                    </Grid>

                </GroupBox>

                <!--  =============================================  -->
                <!--  ④ 结果检查  -->
                <!--  =============================================  -->

                <GroupBox
                    Grid.Row="1"
                    Header="超出上限的地图（生成前总数）"
                    Style="{StaticResource SectionStyle}">

                    <DataGrid
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        ClipboardCopyMode="ExcludeHeader"
                        GridLinesVisibility="Horizontal"
                        IsReadOnly="True"
                        ItemsSource="{Binding GenerationResults}"
                        SelectionChanged="DataGrid_SelectionChanged"
                        SelectionMode="Extended"
                        SelectionUnit="Cell">

                        <DataGrid.Resources>

                            <Style x:Key="CopyableResultTextStyle" TargetType="TextBox">

                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="IBeam" />
                                <Setter Property="IsReadOnly" Value="True" />
                                <Setter Property="IsReadOnlyCaretVisible" Value="True" />

                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />

                            </Style>

                        </DataGrid.Resources>

                        <!--  超出地图怪物上限时标红  -->

                        <DataGrid.RowStyle>

                            <Style TargetType="DataGridRow">

                                <Setter Property="Foreground">

                                    <Setter.Value>

                                        <MultiBinding Converter="{StaticResource MonsterCountToRedBrushConverter}">

                                            <Binding Path="MonsterCount" />

                                            <Binding Path="DataContext.MaxMonstersPerMap" RelativeSource="{RelativeSource AncestorType=UserControl}" />

                                        </MultiBinding>

                                    </Setter.Value>

                                </Setter>

                            </Style>

                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!--  地图代码  -->

                            <DataGridTemplateColumn
                                MinWidth="120"
                                ClipboardContentBinding="{Binding MapCode}"
                                Header="地图代码"
                                SortMemberPath="MapCode">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBox Style="{StaticResource CopyableResultTextStyle}" Text="{Binding MapCode, Mode=OneWay}" />

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!--  地图名称  -->

                            <DataGridTemplateColumn
                                Width="*"
                                ClipboardContentBinding="{Binding MapName}"
                                Header="地图名称"
                                SortMemberPath="MapName">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBox Style="{StaticResource CopyableResultTextStyle}" Text="{Binding MapName, Mode=OneWay}" />

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!--  怪物总数  -->

                            <DataGridTemplateColumn
                                Width="Auto"
                                ClipboardContentBinding="{Binding MonsterCount}"
                                Header="怪物刷新总数"
                                SortMemberPath="MonsterCount">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBox Style="{StaticResource CopyableResultTextStyle}" Text="{Binding MonsterCount, Mode=OneWay}" />

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </GroupBox>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
