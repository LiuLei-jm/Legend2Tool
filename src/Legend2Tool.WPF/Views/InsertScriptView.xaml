<UserControl
    x:Class="Legend2Tool.WPF.Views.InsertScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Legend2Tool.WPF.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Legend2Tool.WPF.ViewModels"
    d:Background="LightGray"
    d:DataContext="{d:DesignInstance Type=vm:InsertScriptViewModel}"
    d:DesignHeight="560"
    d:DesignWidth="1050"
    mc:Ignorable="d">
    <Grid>
        <Border
            Width="380"
            Padding="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Resources>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#212121" />
                </Style>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="登录" />

                <TextBlock Margin="0,0,0,5" Text="用户名" />
                <TextBox
                    Height="32"
                    Margin="0,0,0,15"
                    VerticalContentAlignment="Center"
                    Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,0,0,5" Text="密码" />
                <PasswordBox
                    Height="32"
                    Margin="0,0,0,10"
                    VerticalContentAlignment="Center"
                    behaviors:PasswordBoxBinding.BindPassword="True"
                    behaviors:PasswordBoxBinding.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox
                    Margin="0,0,0,14"
                    Foreground="#212121"
                    IsChecked="{Binding RememberCredentials}"
                    ToolTip="账号密码使用 Windows 当前用户加密保存">
                    记住账号密码
                </CheckBox>

                <Button
                    Height="34"
                    Command="{Binding LoginCommand}"
                    Content="登录" />

                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="#C62828"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            Margin="24"
            Padding="22"
            Background="White"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Resources>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#212121" />
                </Style>
            </Border.Resources>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="脚本套" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="#757575"
                            Text="选择需要操作的脚本套" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,6,0"
                            FontSize="16"
                            Foreground="#2E7D32"
                            Text="●" />
                        <TextBlock VerticalAlignment="Center" Text="已登录" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="搜索" />
                    <TextBox
                        Grid.Column="1"
                        Height="34"
                        Padding="8,0"
                        VerticalContentAlignment="Center"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入脚本套名称或描述进行筛选" />
                </Grid>

                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ScriptSetsView}"
                    RowHeight="62"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="190" Header="脚本套名称">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10,0"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" Header="描述">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Foreground="#616161"
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="290" Header="操作">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            MinWidth="118"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.InstallScriptSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="开始插入脚本套" />
                                        <Button
                                            MinWidth="136"
                                            Command="{Binding DataContext.RemoveScriptSetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="删除已插入脚本套" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="#616161"
                        Text="{Binding ScriptSetStatusMessage}" />
                    <Button
                        Grid.Column="1"
                        MinWidth="88"
                        Command="{Binding LoadScriptSetsCommand}"
                        Content="刷新列表" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
